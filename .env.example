# Server
NODE_ENV=development
PORT=3000
PUBLIC_SITE_URL=http://localhost:4200
CLIENT_ORIGINS=http://localhost:4200,http://localhost:4000

# MongoDB — leave empty to use the embedded development MongoDB (persisted in server/data/mongo)
MONGODB_URI=

# JWT (generate strong random values in production)
JWT_ACCESS_SECRET=dev-access-secret-change-me-please-32chars
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-please-32chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Cloudinary (optional — local disk storage is used when empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=tournament-platform

# Uploads
MAX_UPLOAD_MB=5
UPLOAD_DIR=

# Seeding (development defaults)
SEED_ADMIN_EMAIL=admin@arena.ge
SEED_ADMIN_PASSWORD=Admin123!
SEED_ORGANIZER_EMAIL=organizer@arena.ge
SEED_ORGANIZER_PASSWORD=Organizer123!
